# ═══════════════════════════════════════════
# SEAPEDIA — Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────
DATABASE_URL="postgresql://seapedia:seapedia@localhost:5432/seapedia?schema=public"

# ── JWT ───────────────────────────────────
JWT_SECRET="change-me-to-a-random-string-at-least-32-chars-long"
JWT_REFRESH_SECRET="change-me-to-a-different-random-string-at-least-32-chars"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ── Redis ─────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ── API ───────────────────────────────────
API_PORT="4000"

# ── Frontend (safe to expose) ─────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
